# Supabase project-owned backend
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_URL="https://your-project-id.supabase.co"

# Client-side Supabase configuration
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Optional server-only admin client. Required only by server code that imports client.server.ts.
# Never expose this value with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY="your-server-only-service-role-key"

# Optional cron authentication if/when protected cron routes are enabled.
CRON_SECRET="your-server-only-cron-secret"
# CRON_SECRET_PREVIOUS="previous-secret-during-key-rotation"

# Server-side voice transcription (do not expose to the client)
OPENAI_API_KEY="your-server-side-openai-api-key"
